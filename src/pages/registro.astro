---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
    title="Registro de Usuarios | Constructora Salcedo CSIC" 
    description="Crea tu cuenta institucional en Constructora Salcedo e Ingenieros Consultores E.I.R.L. (CSIC)"
>
    <Navbar />

    <div class="min-h-[85vh] bg-navy-900 py-16 px-6 flex items-center justify-center relative overflow-hidden">
        <!-- Background Overlay -->
        <div class="absolute inset-0 opacity-20 bg-[url('/images/hero-bg.png')] bg-cover bg-center"></div>

        <div class="max-w-lg w-full bg-white rounded-2xl shadow-2xl p-8 relative z-10 border border-gray-100">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brick-500/10 text-brick-500 mb-4">
                    <i class="fa-solid fa-user-plus text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-navy-900">Crear Cuenta en CSIC</h1>
                <p class="text-gray-500 text-sm mt-1">Regístrate para reservar consultas de ingeniería y acceder a cursos</p>
            </div>

            <form id="register-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-1.5">Nombre Completo</label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="text" 
                            id="reg-name" 
                            required 
                            placeholder="Ej. Ing. Juan Pérez"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-1.5">Correo Electrónico</label>
                    <div class="relative">
                        <i class="fa-solid fa-envelope absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="email" 
                            id="reg-email" 
                            required 
                            placeholder="tu.email@ejemplo.com"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-1.5">Teléfono / WhatsApp</label>
                    <div class="relative">
                        <i class="fa-solid fa-phone absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="tel" 
                            id="reg-phone" 
                            required 
                            placeholder="+51 977 715 469"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-1.5">Contraseña</label>
                    <div class="relative">
                        <i class="fa-solid fa-key absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="password" 
                            id="reg-password" 
                            required 
                            placeholder="Mínimo 8 caracteres"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div class="pt-2">
                    <button 
                        type="submit" 
                        class="w-full bg-brick-500 hover:bg-brick-600 text-white font-bold py-3.5 rounded-lg shadow-lg hover:shadow-brick-500/30 transition-all flex items-center justify-center gap-2"
                    >
                        <i class="fa-solid fa-user-check"></i> Registrar mi Cuenta
                    </button>
                </div>
            </form>

            <div id="register-alert" class="hidden mt-4 p-3 rounded-lg text-sm text-center"></div>

            <div class="mt-6 pt-6 border-t border-gray-100 text-center text-sm text-gray-600">
                ¿Ya tienes una cuenta registrada? 
                <a href="/login" class="text-brick-500 font-bold hover:underline">Inicia sesión</a>
            </div>
        </div>
    </div>

    <Footer />
</Layout>

<script>
    const form = document.getElementById('register-form');
    const alert = document.getElementById('register-alert');

    if (form && alert) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = (document.getElementById('reg-name') as HTMLInputElement).value;
            const email = (document.getElementById('reg-email') as HTMLInputElement).value;

            alert.classList.remove('hidden', 'bg-red-100', 'text-red-700');
            alert.classList.add('bg-green-100', 'text-green-800');
            alert.innerHTML = `<i class="fa-solid fa-circle-check mr-2"></i> ¡Cuenta registrada con éxito, <strong>${name}</strong>! Inicia sesión para continuar.`;

            setTimeout(() => {
                window.location.href = '/login';
            }, 1500);
        });
    }
</script>
