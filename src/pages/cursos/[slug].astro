---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, category, image, price, instructor, syllabus } = entry.data;

const categoryColors = {
    civil: 'bg-brick-500',
    sistemas: 'bg-blue-600',
    minas: 'bg-yellow-600',
    software: 'bg-emerald-600',
};
---

<Layout title={`${title} | Constructora Salcedo`} description={description}>
    <Navbar />

    <!-- Hero Section -->
    <div class="relative bg-navy-900 text-white py-20 lg:py-32 overflow-hidden">
        <div class="absolute inset-0 z-0 opacity-20">
            <Image src={image as any} alt={title} class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/90 to-transparent"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-3xl">
                <span class={`${categoryColors[category]} text-xs font-bold px-3 py-1 rounded uppercase tracking-wider mb-6 inline-block`}>
                    Ingeniería {category.charAt(0).toUpperCase() + category.slice(1)}
                </span>
                <h1 class="text-4xl lg:text-6xl font-bold mb-6 leading-tight">{title}</h1>
                <p class="text-xl text-gray-300 mb-8 font-light">{description}</p>
                
                <div class="flex flex-wrap items-center gap-6 mb-10">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center text-xl font-bold">
                            {instructor.name.charAt(4)}
                        </div>
                        <div>
                            <p class="font-bold">{instructor.name}</p>
                            <p class="text-xs text-gray-400">{instructor.role}</p>
                        </div>
                    </div>
                    <div class="h-10 w-px bg-gray-700 hidden sm:block"></div>
                    <div>
                        <p class="text-xs text-gray-400">Precio</p>
                        <p class="text-2xl font-bold text-brick-500">S/ {price}</p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a href={`/aula/${entry.slug}`} class="bg-brick-500 hover:bg-brick-600 text-white px-8 py-3 rounded-full font-bold text-center transition-transform hover:scale-105 shadow-lg">
                        Inscribirme Ahora
                    </a>
                    <a href="#temario" class="bg-transparent border border-white hover:bg-white hover:text-navy-900 text-white px-8 py-3 rounded-full font-bold text-center transition-colors">
                        Ver Temario
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Content & Syllabus -->
    <div class="container mx-auto px-6 py-16">
        <div class="grid lg:grid-cols-3 gap-12">
            <!-- Main Content -->
            <div class="lg:col-span-2">
                <div class="prose prose-lg text-gray-600 mb-12">
                    <h2 class="text-3xl font-bold text-navy-900 mb-6">Descripción del Curso</h2>
                    <Content />
                </div>

                <div id="temario">
                    <h2 class="text-3xl font-bold text-navy-900 mb-8">Temario del Curso</h2>
                    <div class="space-y-4">
                        {syllabus.map((module, index) => (
                            <div class="border border-gray-200 rounded-lg overflow-hidden">
                                <button class="w-full flex justify-between items-center p-4 bg-gray-50 hover:bg-gray-100 transition-colors text-left focus:outline-none" onclick={`document.getElementById('module-${index}').classList.toggle('hidden');`}>
                                    <span class="font-bold text-navy-800">{module.title}</span>
                                    <i class="fa-solid fa-chevron-down text-gray-500"></i>
                                </button>
                                <div id={`module-${index}`} class="hidden p-4 bg-white border-t border-gray-100">
                                    <ul class="space-y-2">
                                        {module.items.map(item => (
                                            <li class="flex items-start gap-3 text-gray-600">
                                                <i class="fa-solid fa-circle-play text-brick-500 mt-1 text-sm"></i>
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100 sticky top-24">
                    <h3 class="text-xl font-bold text-navy-900 mb-4">¿Que incluye este curso?</h3>
                    <ul class="space-y-4 mb-6">
                        <li class="flex items-center gap-3 text-gray-600">
                            <i class="fa-solid fa-video text-brick-500 w-6"></i>
                            Acceso vitalicio
                        </li>
                        <li class="flex items-center gap-3 text-gray-600">
                            <i class="fa-solid fa-file-pdf text-brick-500 w-6"></i>
                            Material descargable
                        </li>
                        <li class="flex items-center gap-3 text-gray-600">
                            <i class="fa-solid fa-certificate text-brick-500 w-6"></i>
                            Certificado digital
                        </li>
                        <li class="flex items-center gap-3 text-gray-600">
                            <i class="fa-solid fa-mobile-screen text-brick-500 w-6"></i>
                            Acceso en móviles
                        </li>
                    </ul>
                    <a href={`/aula/${entry.slug}`} class="block w-full bg-navy-900 hover:bg-navy-800 text-white text-center py-3 rounded-lg font-bold transition-colors">
                        Empezar a Aprender
                    </a>
                </div>
            </div>
        </div>
    </div>

    <Footer />
</Layout>
