---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
    title="Iniciar Sesión | Constructora Salcedo CSIC" 
    description="Accede a tu cuenta institucional en Constructora Salcedo e Ingenieros Consultores E.I.R.L. (CSIC)"
>
    <Navbar />

    <div class="min-h-[80vh] bg-navy-900 py-16 px-6 flex items-center justify-center relative overflow-hidden">
        <!-- Background Overlay -->
        <div class="absolute inset-0 opacity-20 bg-[url('/images/hero-bg.png')] bg-cover bg-center"></div>

        <div class="max-w-md w-full bg-white rounded-2xl shadow-2xl p-8 relative z-10 border border-gray-100">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brick-500/10 text-brick-500 mb-4">
                    <i class="fa-solid fa-user-lock text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-navy-900">Iniciar Sesión en CSIC</h1>
                <p class="text-gray-500 text-sm mt-1">Accede a tus reservas de consultas y aula virtual</p>
            </div>

            <form id="login-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-2">Correo Electrónico</label>
                    <div class="relative">
                        <i class="fa-solid fa-envelope absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="email" 
                            id="login-email" 
                            required 
                            placeholder="tu.email@ejemplo.com"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-navy-900 mb-2">Contraseña</label>
                    <div class="relative">
                        <i class="fa-solid fa-key absolute left-4 top-3.5 text-gray-400"></i>
                        <input 
                            type="password" 
                            id="login-password" 
                            required 
                            placeholder="••••••••"
                            class="w-full pl-11 pr-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brick-500 focus:border-brick-500 outline-none text-sm transition-all"
                        />
                    </div>
                </div>

                <div class="flex items-center justify-between text-xs text-gray-600">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="rounded text-brick-500 focus:ring-brick-500" />
                        Recordar sesión
                    </label>
                    <a href="#" class="text-brick-500 font-semibold hover:underline">¿Olvidaste tu contraseña?</a>
                </div>

                <button 
                    type="submit" 
                    class="w-full bg-brick-500 hover:bg-brick-600 text-white font-bold py-3.5 rounded-lg shadow-lg hover:shadow-brick-500/30 transition-all flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
                </button>
            </form>

            <div id="login-alert" class="hidden mt-4 p-3 rounded-lg text-sm text-center"></div>

            <div class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-600">
                ¿Aún no tienes cuenta? 
                <a href="/registro" class="text-brick-500 font-bold hover:underline">Regístrate aquí</a>
            </div>
        </div>
    </div>

    <Footer />
</Layout>

<script>
    const form = document.getElementById('login-form');
    const alert = document.getElementById('login-alert');

    if (form && alert) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = (document.getElementById('login-email') as HTMLInputElement).value;
            
            // Simulación de Login exitoso
            alert.classList.remove('hidden', 'bg-red-100', 'text-red-700');
            alert.classList.add('bg-green-100', 'text-green-800');
            alert.innerHTML = `<i class="fa-solid fa-circle-check mr-2"></i> ¡Bienvenido/a! Sesión iniciada correctamente como <strong>${email}</strong>. Redireccionando...`;

            localStorage.setItem('csic_user', JSON.stringify({ email, rol: 'cliente' }));

            setTimeout(() => {
                window.location.href = '/reservar';
            }, 1500);
        });
    }
</script>
