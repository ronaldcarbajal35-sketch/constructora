---
// Navbar sticky component - Software Engineering
---

<nav
    class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md text-white border-b border-navy-800 shadow-lg transition-all duration-300"
>
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <!-- Logo -->
        <a
            href="/"
            class="text-xl font-extrabold tracking-wider flex items-center gap-3 text-white"
        >
            <div class="w-10 h-10 rounded-lg bg-emerald-600 flex items-center justify-center text-white text-xl font-bold shadow-md shadow-emerald-900/50">
                <i class="fa-solid fa-code"></i>
            </div>
            <div class="flex flex-col">
                <span class="leading-none text-lg">SALCEDO <span class="text-emerald-400">TECH</span></span>
                <span class="text-[10px] text-gray-400 font-normal tracking-widest uppercase">Software Engineering</span>
            </div>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center space-x-8 font-medium text-sm">
            <a href="/#inicio" class="hover:text-emerald-400 transition-colors"
                >Inicio</a
            >
            <a href="/#metodologia" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5"
                ><i class="fa-solid fa-layer-group text-xs text-emerald-400"></i> Metodología SDLC</a
            >
            <a href="/#servicios" class="hover:text-emerald-400 transition-colors"
                >Servicios Dev</a
            >
            <a href="/#academia" class="hover:text-emerald-400 transition-colors"
                >Academia Software</a
            >
            <a href="/#contacto" class="hover:text-emerald-400 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- CTA Button -->
        <a
            href="https://wa.me/51977715469"
            target="_blank"
            class="hidden md:inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-transform transform hover:scale-105 shadow-md shadow-emerald-950"
        >
            <i class="fa-brands fa-whatsapp text-lg"></i>
            Cotizar Software
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-2xl focus:outline-none">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <!-- Mobile Menu Container -->
    <div id="mobile-menu" class="hidden md:hidden bg-navy-900 border-t border-navy-800">
        <div class="container mx-auto px-6 py-4 flex flex-col space-y-4 text-sm">
            <a href="/#inicio" class="mobile-link hover:text-emerald-400 transition-colors">Inicio</a>
            <a href="/#metodologia" class="mobile-link hover:text-emerald-400 transition-colors">Metodología SDLC</a>
            <a href="/#servicios" class="mobile-link hover:text-emerald-400 transition-colors">Servicios Dev</a>
            <a href="/#academia" class="mobile-link hover:text-emerald-400 transition-colors">Academia Software</a>
            <a href="/#contacto" class="mobile-link hover:text-emerald-400 transition-colors">Contacto</a>
            <a href="https://wa.me/51977715469" target="_blank" class="text-emerald-400 font-semibold">
                <i class="fa-brands fa-whatsapp mr-2"></i>Cotizar Software por WhatsApp
            </a>
        </div>
    </div>
</nav>

<script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close menu when a link is clicked
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });
    }
</script>
